rules_version = '2';

// Regras de segurança do Firestore para o app "Controle de Colhedoras"
// Cole este conteúdo em: Firebase Console > Firestore Database > Regras
//
// O que estas regras garantem:
// - Cada pessoa só lê e escreve os PRÓPRIOS dados de colhedoras (coleção "userdata")
// - Ninguém consegue ler os dados de outra pessoa, exceto administradores
// - Só um administrador pode transformar outro usuário em administrador
// - Qualquer visitante sem login é bloqueado (require auth != null em tudo)

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return estaLogado() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Campos que o próprio usuário NUNCA pode alterar sozinho (só admin ou as
    // Cloud Functions de assinatura, que usam o Admin SDK e ignoram estas regras)
    function camposProtegidosMantidos() {
      return request.resource.data.role == resource.data.role &&
             request.resource.data.plan == resource.data.plan &&
             request.resource.data.get('subscriptionId', null) == resource.data.get('subscriptionId', null) &&
             request.resource.data.get('planStatus', null) == resource.data.get('planStatus', null) &&
             request.resource.data.get('trialEnd', null) == resource.data.get('trialEnd', null) &&
             request.resource.data.get('planExpiraEm', null) == resource.data.get('planExpiraEm', null) &&
             request.resource.data.get('pixPaymentId', null) == resource.data.get('pixPaymentId', null) &&
             request.resource.data.get('cpfMascarado', null) == resource.data.get('cpfMascarado', null) &&
             request.resource.data.get('exigeVerificacaoEmail', null) == resource.data.get('exigeVerificacaoEmail', null) &&
             request.resource.data.get('planoEscolhido', null) == resource.data.get('planoEscolhido', null) &&
             request.resource.data.get('sessaoAtiva', null) == resource.data.get('sessaoAtiva', null);
    }

    // Perfis dos usuários (nome, e-mail, role, plano)
    match /users/{userId} {
      allow read: if estaLogado() && (request.auth.uid == userId || ehAdmin());
      // O perfil de quem se cadastra é criado pelo SERVIDOR (api/registrarUsuario.js,
      // que valida o CPF e define os 7 dias de teste). O navegador não pode criar.
      allow create: if ehAdmin();
      allow update: if estaLogado() && (
                      (request.auth.uid == userId && camposProtegidosMantidos()) ||
                      ehAdmin()
                    );
      allow delete: if ehAdmin();
    }

    // Dados de colhedoras/cálculos de cada usuário
    match /userdata/{userId} {
      allow read, write: if estaLogado() && (request.auth.uid == userId || ehAdmin());
    }

    // Pedidos de ajuda de quem clicou em "Não consegui confirmar o e-mail"
    // (tela verificar-email.html). Só a própria pessoa cria/atualiza o seu
    // pedido (sempre como "não atendido"); só o admin lê a lista e marca
    // como atendido depois de liberar o acesso manualmente.
    match /pedidosVerificacao/{userId} {
      allow read: if ehAdmin();
      allow create, update: if estaLogado() && request.auth.uid == userId &&
                              request.resource.data.uid == userId &&
                              request.resource.data.atendido == false;
      allow update: if ehAdmin();
      allow delete: if ehAdmin();
    }

    // Tokens de notificação push (Firebase Cloud Messaging) de cada admin,
    // um documento por aparelho/navegador em que ele ativou as notificações.
    // Só o próprio dono gerencia os tokens dele pelo navegador; a API
    // notificarAdmins.js lê todos usando o Admin SDK (que ignora estas
    // regras), então não precisa de permissão de leitura por admin aqui.
    match /pushTokens/{userId}/tokens/{tokenId} {
      allow read, write: if estaLogado() && request.auth.uid == userId;
    }
  }
}
